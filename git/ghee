#!/usr/bin/env bash
# ghee: the butterscripts fzf suite, clarified into one program.
#
#   ghee [command] [args]
#     (bare)        dirty repo: changes; otherwise: repos hub
#     repos [dir]   repo hub (dir defaults to $GHEE_BASE, itself ~/ButterForge)
#     changes       working-tree cockpit: stage/unstage/discard live
#     log [args]    pick a commit, diff preview; prints the hash
#     files [args]  pick a tracked file, history preview; edits it (prints when piped)
#     ssh           pick a host from ~/.ssh/config and connect
#     commit        review changes, discard strays, commit & push (add -A)
#     status [dir]  read-only dashboard of every repo under a base dir
#     sweep [dir]   run the commit flow in every repo with unpushed work
#     today [dir]   today's commit counts across repos, with a total
#
# Symlink-aware: invoked as fzf-repos / fzf-changes / fzf-log / fzf-files /
# fzf-ssh / buttergit-tui / butter-status it runs that tool, so the old
# names keep working:
#   ln -s ghee ~/.local/bin/fzf-repos   (etc.)
#
# log/files/changes print selections to stdout, so they compose:
#   git show $(ghee log)
#   $EDITOR $(ghee files)
#   git add $(ghee changes)

set -uo pipefail

SELF=$(readlink -f "$0")
SSH_CONFIG="$HOME/.ssh/config"
# Default base for repos/status/sweep/today; resolve_base falls back to $PWD.
GHEE_BASE="${GHEE_BASE:-$HOME/ButterForge}"
# How deep to look for repos under the base (2 = flat layout; ghq-style needs 4).
GHEE_DEPTH="${GHEE_DEPTH:-2}"
SEP='─────────────────────────────'

die() { printf '%s\n' "$1" >&2; exit 1; }

# Uses transform()/FZF_TOTAL_COUNT, so 0.45 is a hard floor (Debian 13: 0.60).
need_fzf() {
    command -v fzf >/dev/null 2>&1 || die 'fzf not installed'
    local v maj min
    v=$(fzf --version 2>/dev/null | awk '{print $1}')
    [[ "$v" =~ ^[0-9]+\.[0-9]+ ]] || return 0
    IFS=. read -r maj min _ <<<"$v"
    (( maj == 0 && min < 45 )) && die "fzf $v is too old — ghee needs 0.45+ (Debian 13 ships 0.60)"
    return 0
}
need_repo() { git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 'Not inside a git repo'; }

porcelain() { git -c core.quotePath=false status --porcelain=v1 2>/dev/null; }

# Sets $base in the caller: arg, else $GHEE_BASE, else the current dir.
resolve_base() {
    base="${1:-$GHEE_BASE}"
    [[ -z "${1:-}" && ! -d "$base" ]] && base=$PWD
    [[ -d "$base" ]] || die "No such directory: $base"
    [[ "$base" != / ]] && base="${base%/}"
}

# Repos under a base, as relative paths ('.' = the base itself), one per line.
# Matches .git files too, so linked worktrees count as repos.
find_repos() {
    local g d
    while IFS= read -r g; do
        d="${g%/.git}"
        d="${d#"$1"}"
        d="${d#/}"
        printf '%s\n' "${d:-.}"
    done < <(find "$1" -maxdepth "$GHEE_DEPTH" -name .git -prune 2>/dev/null) | sort
}

# House fzf defaults; callers append their own flags (later flags win).
# Ctrl-/ cycles the preview: 70% (default) → 50% → hidden.
fzf_run() {
    FZF_DEFAULT_OPTS='' fzf --ansi --height=100% --border --reverse \
        --info=inline --preview-window=right:70%:wrap \
        --bind='ctrl-/:change-preview-window(right,50%|hidden|)' "$@"
}

# Resolve rename targets, then strip/unescape git's quoted path wrapping.
extract_path() {
    local status="$1" rest="$2"
    if [[ "${status:0:1}" == "R" || "${status:0:1}" == "C" ]]; then
        rest="${rest##* -> }"
    fi
    if [[ "$rest" == \"*\" ]]; then
        rest="${rest:1:${#rest}-2}"
        rest="${rest//\\\"/\"}"
        rest=$(printf '%b' "$rest")
    fi
    printf '%s' "$rest"
}

# Expand selected porcelain lines ("XY path" args) to paths, one per line.
# Renames yield both sides so unstage/discard catch the staged old-path too.
selected_paths() {
    local raw status rest
    for raw in "$@"; do
        status="${raw:0:2}"
        rest="${raw:3}"
        if [[ "${status:0:1}" == "R" || "${status:0:1}" == "C" ]]; then
            extract_path '  ' "${rest%% -> *}"
            echo
        fi
        extract_path "$status" "$rest"
        echo
    done
}

# ================= repos =================

# One repo: name TAB changes TAB ahead TAB behind. Single printf = atomic line.
repo_stat_one() {
    local dir="$1/$2" changes ahead behind track
    changes=$(git -C "$dir" --no-optional-locks status --porcelain=v1 2>/dev/null | wc -l)
    ahead=0
    behind=0
    while IFS= read -r track; do
        [[ -z "$track" ]] && continue
        [[ "$track" =~ ahead[[:space:]]+([0-9]+) ]] && ahead=$((ahead + BASH_REMATCH[1]))
        [[ "$track" =~ behind[[:space:]]+([0-9]+) ]] && behind=$((behind + BASH_REMATCH[1]))
    done < <(git -C "$dir" for-each-ref --format='%(upstream:track,nobracket)' refs/heads/ 2>/dev/null)
    printf '%s\t%s\t%s\t%s\n' "$2" "$changes" "$ahead" "$behind"
}

# All repos under a base, scanned in parallel, sorted by name.
repo_stats() {
    find_repos "$1" \
        | xargs -r -d '\n' -P "$(nproc 2>/dev/null || echo 4)" -I{} "$SELF" __repo-stat "$1" {} \
        | sort
}

list_repos() {
    local name changes ahead behind active marker activity sort_key
    while IFS=$'\t' read -r name changes ahead behind; do
        active=0
        (( changes > 0 || ahead > 0 || behind > 0 )) && active=1

        marker=' '
        (( changes > 0 )) && marker=$'\e[35m●\e[0m'

        activity=''
        (( ahead > 0 )) && activity+=$(printf ' \e[1;33m↑%d\e[0m' "$ahead")
        (( behind > 0 )) && activity+=$(printf ' \e[1;33m↓%d\e[0m' "$behind")

        sort_key=$([[ $active -eq 1 ]] && echo '0' || echo '1')
        # Output: sortkey TAB name TAB display; sort, then drop sortkey.
        printf '%s\t%s\t%s %-24s%s\n' "${sort_key}_${name}" "$name" "$marker" "$name" "$activity"
    done < <(repo_stats "$1") | sort | cut -f2-
}

preview_repo() {
    local base="$1" name="${2:-}"
    if [[ -z "$name" ]]; then
        echo '(no selection)'
        return
    fi
    local target="$base/$name"
    if [[ ! -e "$target/.git" ]]; then
        printf 'Not a git repo: %s\n' "$name"
        return
    fi
    cd "$target" || return

    printf '\e[1m%s\e[0m  ' "$name"
    printf '\e[36m%s\e[0m\n' "$(git symbolic-ref --short HEAD 2>/dev/null || echo '(detached)')"
    printf '%s\n\n' "$SEP"

    local status stat diff_out unpushed
    status=$(git -c color.status=always status --short 2>/dev/null)
    if [[ -n "$status" ]]; then
        printf '\e[1;33mChanged files:\e[0m\n%s\n\n' "$status"
        stat=$(git diff HEAD --color=always --stat 2>/dev/null)
        [[ -n "$stat" ]] && printf '\e[1;33mSummary:\e[0m\n%s\n\n' "$stat"
        diff_out=$(git diff HEAD --color=always 2>/dev/null)
        [[ -n "$diff_out" ]] && printf '\e[1;33mDiff (vs HEAD):\e[0m\n%s\n\n' "$diff_out"
    fi

    unpushed=$(git log '@{u}..HEAD' --color=always --stat -p 2>/dev/null || true)
    [[ -n "$unpushed" ]] && printf '\e[1;33mUnpushed commits:\e[0m\n%s\n\n' "$unpushed"

    printf '\e[2mRecent:\e[0m\n'
    git log --oneline -10 --color=always 2>/dev/null || true
}

run_repos() {
    local base; resolve_base "${1:-}"
    need_fzf

    local base_q output key selection name target
    printf -v base_q '%q' "$base"
    while true; do
        output=$(
            list_repos "$base" | fzf_run \
                --delimiter=$'\t' \
                --with-nth=2.. \
                --no-multi \
                --prompt='repos> ' \
                --preview="$SELF __preview-repo $base_q {1}" \
                --header=$'Enter shell · Alt-p push\nAlt-l log · Alt-f files\nAlt-s changes · Esc quit' \
                --expect=alt-p,alt-l,alt-f,alt-s
        ) || true
        [[ -z "$output" ]] && exit 0

        key=$(printf '%s\n' "$output" | head -n 1)
        selection=$(printf '%s\n' "$output" | sed -n '2p')
        # Hotkey with nothing selected: stay in the hub rather than quit.
        if [[ -z "$selection" ]]; then
            [[ -n "$key" ]] && continue
            exit 0
        fi

        name=$(printf '%s' "$selection" | cut -f1)
        target="$base/$name"
        [[ -e "$target/.git" ]] || { printf 'Not a git repo: %s\n' "$target" >&2; continue; }

        # Every key returns to the hub except alt-p, which commits and leaves.
        case "$key" in
            alt-l) (cd "$target" && run_log) ;;
            alt-f) (cd "$target" && run_files) ;;
            alt-s) (cd "$target" && run_changes) ;;
            alt-p) cd "$target" && run_commit; exit $? ;;
            *)     (cd "$target" && "$SHELL") ;;
        esac
    done
}

# ================= changes =================

list_changes() {
    # Colorize like git status: staged char green, worktree char red.
    local line x y
    while IFS= read -r line; do
        x="${line:0:1}" y="${line:1:1}"
        [[ "$x" != ' ' && "$x" != '?' ]] && x=$'\e[32m'"$x"$'\e[0m'
        [[ "$y" != ' ' ]] && y=$'\e[31m'"$y"$'\e[0m'
        printf '%s%s%s\n' "$x" "$y" "${line:2}"
    done < <(porcelain)
}

counts() {
    local s=0 u=0 t=0 line x y
    while IFS= read -r line; do
        x="${line:0:1}" y="${line:1:1}"
        [[ "$x" == '?' ]] && { t=$((t+1)); continue; }
        [[ "$x" != ' ' ]] && s=$((s+1))
        [[ "$y" != ' ' ]] && u=$((u+1))
    done < <(porcelain)
    printf '%d staged · %d unstaged · %d untracked\n' "$s" "$u" "$t"
    printf 'Tab select · C-s stage\nC-u unstage · C-d discard\nEnter paths · Esc quit\n'
}

do_stage() {
    local f
    while IFS= read -r f; do git add -- "$f" 2>/dev/null; done < <(selected_paths "$@")
}

do_unstage() {
    local f
    while IFS= read -r f; do git reset -q HEAD -- "$f" 2>/dev/null; done < <(selected_paths "$@")
}

# Restore one path to HEAD (deletes untracked).
discard_one() {
    git reset -q HEAD -- "$1" 2>/dev/null
    case "$(git -c core.quotePath=false status --porcelain=v1 -- "$1" 2>/dev/null | head -n1)" in
        '??'*) rm -rf -- "$1" ;;
        ?*)    git checkout -q -- "$1" 2>/dev/null ;;
    esac
}

do_discard() {
    local files f ok
    mapfile -t files < <(selected_paths "$@")
    printf '\e[1;31mdiscard:\e[0m\n'
    printf '  %s\n' "${files[@]}"
    read -r -p "restore to HEAD / delete untracked? [y/N] " ok
    [[ "$ok" =~ ^[Yy]$ ]] || return 0
    for f in "${files[@]}"; do discard_one "$f"; done
}

preview_change() {
    local raw="${1:-}"
    if [[ -z "$raw" ]]; then
        echo '(no selection)'
        return
    fi
    local status="${raw:0:2}" file size cached unstaged
    file=$(extract_path "$status" "${raw:3}")

    printf '\e[1m%s\e[0m  \e[2m[%s]\e[0m\n' "$file" "$status"
    printf '%s\n\n' "$SEP"

    case "$status" in
        '??')
            if [[ -d "$file" ]]; then
                printf '\e[2m(untracked directory)\e[0m\n'
                ls -la "$file" 2>/dev/null | head -50
            elif grep -Iq . "$file" 2>/dev/null; then
                printf '\e[1;33mFile contents (untracked):\e[0m\n'
                head -500 "$file" 2>/dev/null
            else
                size=$(stat -c %s "$file" 2>/dev/null || echo '?')
                printf '\e[2m(binary or non-text, %s bytes)\e[0m\n' "$size"
            fi
            ;;
        *)
            cached=$(git diff --cached --color=always -- "$file" 2>/dev/null)
            [[ -n "$cached" ]] && printf '\e[1;33mStaged:\e[0m\n%s\n\n' "$cached"
            unstaged=$(git diff --color=always -- "$file" 2>/dev/null)
            [[ -n "$unstaged" ]] && printf '\e[1;33mUnstaged:\e[0m\n%s\n' "$unstaged"
            [[ -z "$cached" && -z "$unstaged" ]] && printf '\e[2m(no diff content available)\e[0m\n'
            ;;
    esac
}

run_changes() {
    need_repo
    need_fzf
    if [[ -z "$(porcelain)" ]]; then
        echo 'No changes in working tree.'
        exit 0
    fi

    local selection line
    selection=$(
        list_changes | fzf_run \
            --multi \
            --prompt='changes> ' \
            --preview="$SELF __preview-change {}" \
            --header=$'Tab select · C-s stage\nC-u unstage · C-d discard\nEnter paths · Esc quit' \
            --bind="ctrl-s:execute-silent($SELF __stage {+})+clear-selection+reload($SELF __list-changes)" \
            --bind="ctrl-u:execute-silent($SELF __unstage {+})+clear-selection+reload($SELF __list-changes)" \
            --bind="ctrl-d:execute($SELF __discard {+})+clear-selection+reload($SELF __list-changes)" \
            --bind="load:transform-header($SELF __counts)+transform("'[ "$FZF_TOTAL_COUNT" -eq 0 ] && echo abort)'
    ) || true
    [[ -z "$selection" ]] && exit 0

    while IFS= read -r line; do
        extract_path "${line:0:2}" "${line:3}"
        echo
    done <<< "$selection"
}

# ================= commit =================

# Commits ahead of upstream; 0 when no upstream is configured.
ahead_count() {
    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        git rev-list '@{u}..HEAD' --count 2>/dev/null || echo 0
    else
        echo 0
    fi
}

# Parallel arrays files/statuses from porcelain.
load_status() {
    files=() statuses=()
    local line
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        statuses+=("${line:0:2}")
        files+=("$(extract_path "${line:0:2}" "${line:3}")")
    done < <(porcelain)
}

run_commit() {
    need_repo
    local unpushed files statuses ans file status idx i msg line branch
    unpushed=$(ahead_count)

    load_status
    if [[ ${#files[@]} -eq 0 ]]; then
        if (( unpushed > 0 )); then
            printf '\e[1;33m!\e[0m No working changes, but %d unpushed commit(s):\n' "$unpushed"
            git log '@{u}..HEAD' --oneline | sed 's/^/  /'
            printf '\n\e[1;33mPush now?\e[0m (y/N) '
            read -r ans
            if [[ "$ans" =~ ^[Yy] ]]; then
                if git push; then
                    printf '\e[32m✓ Pushed\e[0m\n'
                else
                    printf '\e[31m✗ Push failed\e[0m\n'
                    exit 1
                fi
            fi
            exit 0
        fi
        printf '\e[32m✓\e[0m No changes to commit\n'
        exit 0
    fi

    # Pre-existing unpushed commits ride along with the new one — warn first.
    if (( unpushed > 0 )); then
        printf '\e[1;33m╭─ %d unpushed commit(s) — will be pushed alongside your new commit\e[0m\n' "$unpushed"
        git log '@{u}..HEAD' --oneline | while IFS= read -r line; do
            printf '\e[1;33m│\e[0m %s\n' "$line"
        done
        printf '\e[1;33m╰─\e[0m\n\n\e[1;33mContinue?\e[0m (Y/n) '
        read -r ans
        if [[ "$ans" =~ ^[Nn] ]]; then
            printf '\e[31m✗\e[0m Aborted\n'
            exit 0
        fi
        echo
    fi

    printf '\e[36m╭─ Changes\e[0m\n'
    git -c core.quotePath=false status -s | sed 's/^/│ /'
    printf '\e[36m╰─\e[0m\n\n'

    printf '\e[35m╭─ Diff\e[0m\n'
    if git rev-parse HEAD >/dev/null 2>&1; then
        git diff HEAD --stat | sed 's/^/│ /'
    else
        git diff --cached --stat | sed 's/^/│ /'
    fi
    printf '\e[35m╰─\e[0m\n\n'

    # Discard round — list refreshes each pass so numbers stay accurate.
    while :; do
        load_status
        [[ ${#files[@]} -eq 0 ]] && break

        printf '\e[1;33mDiscard any files?\e[0m (number/name, c = cockpit, blank = continue)\n'
        for i in "${!files[@]}"; do
            printf '  \e[34m%d.\e[0m %s %s\n' "$((i+1))" "${statuses[$i]}" "${files[$i]}"
        done
        printf '> '
        read -r ans
        [[ -z "$ans" ]] && break

        if [[ "$ans" == c ]]; then
            (run_changes >/dev/null) || true
            continue
        fi

        file='' status=''
        if [[ "$ans" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#files[@]} )); then
            idx=$((ans-1))
            file="${files[$idx]}"
            status="${statuses[$idx]}"
        else
            for i in "${!files[@]}"; do
                [[ "${files[$i]}" == "$ans" ]] && { file="${files[$i]}"; status="${statuses[$i]}"; break; }
            done
        fi
        if [[ -z "$file" ]]; then
            printf '\e[31m!\e[0m Not in change list: %s\n' "$ans"
            continue
        fi
        discard_one "$file"
        printf '\e[31m✗\e[0m Discarded: %s\n' "$file"
    done
    echo

    if [[ ${#files[@]} -eq 0 ]]; then
        printf '\e[32m✓\e[0m All changes discarded\n'
        exit 0
    fi

    printf '\e[36mCommit message\e[0m (empty line to finish):\n'
    msg=""
    while IFS= read -r line; do
        [[ -z "$line" ]] && break
        msg="${msg}${msg:+$'\n'}$line"
    done
    if [[ -z "$msg" ]]; then
        printf '\e[31m✗\e[0m No commit message provided, aborting\n'
        exit 1
    fi

    printf '\n\e[1;33mCommitting...\e[0m\n'
    git add -A || die '✗ git add failed'
    git commit -m "$msg" || die '✗ git commit failed'

    printf '\e[1;33mPushing...\e[0m\n'
    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        git push || die '✗ git push failed'
    else
        branch=$(git symbolic-ref --short HEAD)
        printf '\e[1;33m!\e[0m No upstream set for %s — pushing to origin\n' "$branch"
        git push -u origin "$branch" || die '✗ git push failed'
    fi

    printf '\n\e[32m✓ Changes pushed successfully\e[0m\n'
}

# ================= status =================

# Read-only dashboard: one line per repo, dirty repos first. No interaction.
run_status() {
    local base; resolve_base "${1:-}"

    local name changes ahead behind marker bits total
    local active_rows=() clean_rows=()
    while IFS=$'\t' read -r name changes ahead behind; do
        marker=' '
        (( changes > 0 )) && marker=$'\e[35m●\e[0m'

        bits=''
        if (( changes > 0 )); then
            bits+=$(printf ' \e[35m%d change%s\e[0m' "$changes" "$([[ $changes -eq 1 ]] && echo '' || echo 's')")
        fi
        (( ahead > 0 ))  && bits+=$(printf ' \e[1;33m↑%d\e[0m' "$ahead")
        (( behind > 0 )) && bits+=$(printf ' \e[1;33m↓%d\e[0m' "$behind")

        if (( changes == 0 && ahead == 0 && behind == 0 )); then
            clean_rows+=("$(printf '  %s %-32s \e[2m(clean)\e[0m' "$marker" "$name")")
        else
            active_rows+=("$(printf '  %s %-32s%s' "$marker" "$name" "$bits")")
        fi
    done < <(repo_stats "$base")

    total=$(( ${#active_rows[@]} + ${#clean_rows[@]} ))
    if (( total == 0 )); then
        printf 'No git repos found in %s\n' "$base"
        exit 0
    fi

    printf '\e[1m%s\e[0m  \e[2m(%d repos, %d need attention)\e[0m\n\n' \
        "$base" "$total" "${#active_rows[@]}"
    (( ${#active_rows[@]} > 0 )) && printf '%s\n' "${active_rows[@]}"
    if (( ${#clean_rows[@]} > 0 )); then
        (( ${#active_rows[@]} > 0 )) && echo
        printf '%s\n' "${clean_rows[@]}"
    fi
}

# ================= sweep =================

# Run the commit flow in every repo with uncommitted changes or unpushed commits.
run_sweep() {
    local base; resolve_base "${1:-}"

    # Snapshot the list first so run_commit's prompts read the tty, not the pipe.
    local repos=() rel dir ahead swept=0
    mapfile -t repos < <(find_repos "$base")
    for rel in "${repos[@]}"; do
        dir="$base/$rel"
        ahead=$(git -C "$dir" rev-list '@{u}..HEAD' --count 2>/dev/null || true)
        [[ -z "$(git -C "$dir" status -s 2>/dev/null)" && "${ahead:-0}" -eq 0 ]] && continue
        printf '\e[1;33m=== %s ===\e[0m\n' "$rel"
        (cd "$dir" && run_commit) || true
        echo
        swept=$((swept + 1))
    done
    if (( swept > 0 )); then
        printf 'Swept %d repo%s.\n' "$swept" "$([[ $swept -eq 1 ]] && echo '' || echo 's')"
    else
        echo 'All clean — nothing to sweep.'
    fi
}

# ================= today =================

# Today's commit counts across repos. Filters to your commits when user.email
# is set, so pulled work on shared repos doesn't inflate the tally.
run_today() {
    local base; resolve_base "${1:-}"
    local rel count total=0 repos=0 email author=()
    email=$(git config --get user.email 2>/dev/null || true)
    [[ -n "$email" ]] && author=(--author="$email")

    printf '\e[36mCommits today (%s):\e[0m\n\n' "$(date +%Y-%m-%d)"
    while IFS= read -r rel; do
        count=$(git -C "$base/$rel" log --all --oneline --since=midnight "${author[@]}" 2>/dev/null | wc -l)
        (( count > 0 )) || continue
        printf '  \e[1;33m%3d\e[0m  %s\n' "$count" "$rel"
        total=$((total + count))
        repos=$((repos + 1))
    done < <(find_repos "$base")

    if (( total > 0 )); then
        printf '\n\e[32mTotal: %d commits across %d repos\e[0m\n' "$total" "$repos"
    else
        printf '\e[2mNo commits today.\e[0m\n'
    fi
}

# ================= log =================

run_log() {
    need_repo
    need_fzf
    [[ $# -eq 0 ]] && set -- -n 200

    local selection
    selection=$(
        git log --color=always \
            --pretty='format:%C(auto)%h %s %C(dim)(%cr, %an)%C(reset)' \
            "$@" \
        | fzf_run \
            --no-multi \
            --prompt='log> ' \
            --preview='git show --color=always --stat -p {1}' \
            --header='Enter hash · Esc quit'
    ) || true
    [[ -z "$selection" ]] && exit 0

    printf '%s\n' "$selection" | awk '{print $1}'
}

# ================= files =================

preview_file() {
    local file="${1:-}"
    if [[ -z "$file" ]]; then
        echo '(no selection)'
        return
    fi

    printf '\e[1m%s\e[0m\n' "$file"
    printf '%s\n\n' "$SEP"

    # Highlighted content when bat is around (Debian ships it as batcat).
    local hl
    hl=$(command -v batcat || command -v bat) || hl=
    if [[ -f "$file" ]]; then
        printf '\e[1;33mContent:\e[0m\n'
        if [[ -n "$hl" ]]; then
            "$hl" --color=always --style=plain --line-range=:200 -- "$file" 2>/dev/null
        elif grep -Iq '' -- "$file" 2>/dev/null; then
            head -n 200 -- "$file"
        else
            printf '\e[2m(binary file)\e[0m\n'
        fi
        echo
    fi

    local log_out wt_diff last
    printf '\e[1;33mRecent commits touching this file:\e[0m\n'
    log_out=$(git log -n 10 --color=always \
        --pretty='format:%C(auto)%h %s %C(dim)(%cr, %an)%C(reset)' \
        -- "$file" 2>/dev/null)
    if [[ -n "$log_out" ]]; then
        printf '%s\n' "$log_out"
    else
        printf '\e[2m(no commits affect this file)\e[0m\n'
    fi
    echo

    wt_diff=$(git diff HEAD --color=always -- "$file" 2>/dev/null || true)
    [[ -n "$wt_diff" ]] && printf '\n\e[1;33mUncommitted changes:\e[0m\n%s\n\n' "$wt_diff"

    last=$(git log -n 1 --pretty='%H' -- "$file" 2>/dev/null)
    if [[ -n "$last" ]]; then
        printf '\n\e[1;33mLatest commit affecting this file:\e[0m\n'
        git show --color=always "$last" -- "$file" 2>/dev/null
    fi
}

run_files() {
    need_repo
    need_fzf

    # Terminal: Enter opens $EDITOR in place, picker stays open. Piped: Enter
    # prints the path so $(ghee files) still composes.
    if [[ -t 1 ]]; then
        local editor="${VISUAL:-${EDITOR:-vi}}"
        git ls-files "$@" | fzf_run \
            --no-multi \
            --prompt='files> ' \
            --preview="$SELF __preview-file {}" \
            --header='Enter edit · Esc quit' \
            --bind="enter:execute($editor {})"
        return 0
    fi

    local selection
    selection=$(
        git ls-files "$@" | fzf_run \
            --no-multi \
            --prompt='files> ' \
            --preview="$SELF __preview-file {}" \
            --header='Enter path · Esc quit'
    ) || true
    [[ -z "$selection" ]] && exit 0

    printf '%s\n' "$selection"
}

# ================= ssh =================

# The config plus one level of Include; relative globs resolve to ~/.ssh.
ssh_config_files() {
    local g f
    printf '%s\n' "$SSH_CONFIG"
    while IFS= read -r g; do
        g="${g/#\~/$HOME}"
        [[ "$g" == /* ]] || g="$HOME/.ssh/$g"
        for f in $g; do [[ -f "$f" ]] && printf '%s\n' "$f"; done
    done < <(awk 'tolower($1)=="include" {for (i=2; i<=NF; i++) print $i}' "$SSH_CONFIG" 2>/dev/null)
}

list_hosts() {
    local files
    mapfile -t files < <(ssh_config_files)
    awk 'tolower($1)=="host" {for (i=2; i<=NF; i++) if ($i !~ /[*?!]/) print $i}' \
        "${files[@]}" 2>/dev/null | sort -u
}

preview_ssh() {
    local host="${1:-}"
    if [[ -z "$host" ]]; then
        echo '(no selection)'
        return
    fi

    printf '\e[1m%s\e[0m\n' "$host"
    printf '%s\n\n' "$SEP"

    # ssh -G resolves the full effective config without connecting.
    local resolved user hostname port key
    resolved=$(ssh -G "$host" 2>/dev/null)
    user=$(awk '$1=="user"{print $2; exit}' <<<"$resolved")
    hostname=$(awk '$1=="hostname"{print $2; exit}' <<<"$resolved")
    port=$(awk '$1=="port"{print $2; exit}' <<<"$resolved")

    printf '\e[1;33mResolves to:\e[0m\n'
    printf '  %s@%s' "${user:-?}" "${hostname:-?}"
    [[ -n "$port" && "$port" != "22" ]] && printf '  \e[1;33mport %s\e[0m' "$port"
    echo

    # Only list identity files that exist (ssh -G also emits defaults).
    while IFS= read -r key; do
        key="${key/#\~/$HOME}"
        [[ -f "$key" ]] && printf '  \e[2mkey: %s\e[0m\n' "$key"
    done < <(awk '$1=="identityfile"{print $2}' <<<"$resolved")
    echo

    printf '\e[1;33mConfig block:\e[0m\n'
    local files
    mapfile -t files < <(ssh_config_files)
    awk -v h="$host" '
        FNR==1 { p=0 }
        tolower($1)=="host" { p=0; for (i=2; i<=NF; i++) if ($i==h) p=1 }
        p' "${files[@]}" 2>/dev/null
}

run_ssh() {
    need_fzf
    [[ -f "$SSH_CONFIG" ]] || die "No $SSH_CONFIG"

    local hosts selection
    hosts=$(list_hosts)
    [[ -n "$hosts" ]] || die "No Host entries in $SSH_CONFIG"

    selection=$(
        printf '%s\n' "$hosts" | fzf_run \
            --no-multi \
            --prompt='ssh> ' \
            --preview="$SELF __preview-ssh {}" \
            --preview-window=right:60%:wrap \
            --header='Enter connect · Esc quit'
    ) || true
    [[ -z "$selection" ]] && exit 0

    if [[ -t 1 ]]; then
        exec ssh "$selection"
    else
        printf '%s\n' "$selection"
    fi
}

# ================= dispatch =================

usage() {
    cat <<EOF
ghee — butterscripts fzf suite
usage: ghee [command] [args]
  (bare ghee)     dirty repo: changes; otherwise: repos hub
  repos [dir]     repo hub (dir defaults to \$GHEE_BASE, then ~/ButterForge)
  changes         stage/unstage/discard cockpit; prints paths
  log [args]      pick a commit; prints hash (takes git-log args)
  files [args]    pick a tracked file; edit it (prints path when piped)
  ssh             pick a ~/.ssh/config host; connect (prints when piped)
  commit          review changes, discard strays, commit & push (add -A)
  status [dir]    read-only dashboard of every repo under a base dir
  sweep [dir]     run the commit flow in every repo with unpushed work
  today [dir]     today's commit counts across repos, with a total
Base dir: argument, else \$GHEE_BASE, else ~/ButterForge, else the current dir.
Repo search depth under the base: \$GHEE_DEPTH (default 2; ghq layouts need 4).
Also answers to symlink names: fzf-repos fzf-changes fzf-log fzf-files
fzf-ssh buttergit-tui butter-status
EOF
}

# Internal callbacks (fzf previews/actions) — before name dispatch.
case "${1:-}" in
    __preview-repo)   shift; preview_repo "${1:-}" "${2:-}"; exit 0 ;;
    __repo-stat)      shift; repo_stat_one "${1:-}" "${2:-}"; exit 0 ;;
    __list-changes)   list_changes; exit 0 ;;
    __counts)         counts; exit 0 ;;
    __stage)          shift; do_stage "$@"; exit 0 ;;
    __unstage)        shift; do_unstage "$@"; exit 0 ;;
    __discard)        shift; do_discard "$@"; exit 0 ;;
    __preview-change) shift; preview_change "${1:-}"; exit 0 ;;
    __preview-file)   shift; preview_file "${1:-}"; exit 0 ;;
    __preview-ssh)    shift; preview_ssh "${1:-}"; exit 0 ;;
esac

prog=${0##*/}
case "$prog" in
    fzf-repos)   cmd=repos ;;
    fzf-changes) cmd=changes ;;
    fzf-log)     cmd=log ;;
    fzf-files)   cmd=files ;;
    fzf-ssh)       cmd=ssh ;;
    buttergit-tui) cmd=commit ;;
    butter-status) cmd=status ;;
    *)
        if [[ $# -eq 0 ]]; then
            # Bare ghee: open whatever has work to do — dirty tree, else the hub.
            if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [[ -n "$(porcelain)" ]]; then
                cmd=changes
            else
                cmd=repos
            fi
        else
            cmd="$1"
            shift
        fi
        ;;
esac

case "$cmd" in
    repos)          run_repos "${1:-}" ;;
    changes)        run_changes ;;
    log)            run_log "$@" ;;
    files)          run_files "$@" ;;
    ssh)            run_ssh ;;
    commit|push)    run_commit ;;
    status)         run_status "${1:-}" ;;
    sweep)          run_sweep "${1:-}" ;;
    today)          run_today "${1:-}" ;;
    -h|--help|help) usage ;;
    *)              die "ghee: unknown command: $cmd (try: ghee help)" ;;
esac
