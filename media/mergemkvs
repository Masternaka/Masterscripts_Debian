#!/usr/bin/env bash
# mergemkvs: losslessly concatenate every mkv in ~/Videos

VIDEOS=$HOME/Videos
TEMP=$VIDEOS/temp_merged_output.mkv
LIST=$(mktemp --suffix=.txt)
trap 'rm -f "$LIST"' EXIT

case ${1:-} in
	-h|--help)
		cat <<EOF
usage: mergemkvs
Losslessly concatenate every mkv in ~/Videos in version-sort order.
Warns on disk-space shortage or mismatched video parameters. After a
successful merge, offers to archive sources to a sources_<name>/ subfolder.
EOF
		exit 0 ;;
esac

if ! command -v ffmpeg >/dev/null; then
	echo "mergemkvs: ffmpeg required (apt install ffmpeg / dnf install ffmpeg / pacman -S ffmpeg)" >&2
	exit 1
fi
[ -d "$VIDEOS" ] || { echo "mergemkvs: $VIDEOS: not found" >&2; exit 1; }

fmt() {
	awk -v d="$1" 'BEGIN {
		h=int(d/3600); m=int((d%3600)/60); s=int(d%60)
		if (h) printf "%d:%02d:%02d", h, m, s
		else   printf "%d:%02d", m, s
	}'
}

sz() { numfmt --to=iec --suffix=B --format="%.1f" "$1"; }

files=()
while IFS= read -r -d '' f; do
	[[ "$(basename "$f")" == "$(basename "$TEMP")" ]] && continue
	files+=("$f")
done < <(find "$VIDEOS" -maxdepth 1 -name '*.mkv' -type f -print0 | sort -Vz)

[ ${#files[@]} -gt 0 ] || { echo "mergemkvs: no mkv files in $VIDEOS" >&2; exit 1; }

# Per file: duration + first video stream params, plus an audio-stream signature.
declare -a durs codecs reses fps sizes auds
total=0
for f in "${files[@]}"; do
	d= c= w= h= r=
	while IFS='=' read -r k v; do
		case $k in
			duration)     d=$v ;;
			codec_name)   c=$v ;;
			width)        w=$v ;;
			height)       h=$v ;;
			r_frame_rate) r=$v ;;
		esac
	done < <(ffprobe -v error -select_streams v:0 \
		-show_entries format=duration \
		-show_entries stream=codec_name,width,height,r_frame_rate \
		-of default=noprint_wrappers=1 "$f")
	# codec,channels per audio stream, joined: e.g. aac,2,ac3,6
	a=$(ffprobe -v error -select_streams a \
		-show_entries stream=codec_name,channels \
		-of csv=p=0 "$f" | paste -sd, -)
	s=$(stat -c '%s' "$f")
	durs+=("${d:-0}"); codecs+=("${c:-?}"); reses+=("${w:-?}x${h:-?}"); fps+=("${r:-?}"); sizes+=("$s"); auds+=("${a:-none}")
	total=$((total + s))
done
tdur=$(printf '%s\n' "${durs[@]}" | awk '{s+=$1} END{printf "%.3f", s}')

for i in "${!files[@]}"; do
	printf '%2d  %-40s  %8s  %8s\n' \
		$((i+1)) "$(basename "${files[$i]}")" \
		"$(fmt "${durs[$i]}")" "$(sz "${sizes[$i]}")"
done
printf '%d files  %s  %s\n' "${#files[@]}" "$(fmt "$tdur")" "$(sz "$total")"

warned=0
free=$(df -B1 --output=avail "$VIDEOS" | tail -n1 | tr -d ' ')
if [ "$free" -lt "$total" ]; then
	echo "warning: free space $(sz "$free") < input $(sz "$total")"
	warned=1
fi

mismatch=0
for i in "${!codecs[@]}"; do
	[[ "${codecs[$i]}" != "${codecs[0]}" || "${reses[$i]}" != "${reses[0]}" || "${fps[$i]}" != "${fps[0]}" || "${auds[$i]}" != "${auds[0]}" ]] && mismatch=1
done
if [ "$mismatch" = 1 ]; then
	echo "warning: mixed stream parameters; concat may drift"
	declare -A seen
	for i in "${!codecs[@]}"; do
		k="${codecs[$i]}/${reses[$i]}/${fps[$i]}/${auds[$i]}"
		[ -z "${seen[$k]:-}" ] && { seen[$k]=1; echo "  ${codecs[$i]} ${reses[$i]} ${fps[$i]}  audio:${auds[$i]}"; }
	done
	warned=1
fi

if [ "$warned" = 1 ]; then
	read -p "continue anyway? [y/N] " ok
	[[ $ok =~ ^[Yy]$ ]] || exit 0
fi

: > "$LIST"
for f in "${files[@]}"; do
	e=${f//\'/\'\\\'\'}
	printf "file '%s'\n" "$e" >> "$LIST"
done

if ! ffmpeg -hide_banner -loglevel warning -stats -y \
	-f concat -safe 0 -i "$LIST" -c copy -map 0 "$TEMP"
then
	rm -f "$TEMP"
	echo "mergemkvs: ffmpeg failed" >&2
	exit 1
fi

echo
while :; do
	read -p "output name: " name
	[ -z "$name" ] && continue
	[[ $name == */* ]] && { echo "name cannot contain slashes" >&2; continue; }
	[[ $name == *.mkv ]] || name=$name.mkv
	out=$VIDEOS/$name
	if [ -e "$out" ]; then
		read -p "overwrite $name? [y/N] " ow
		[[ $ow =~ ^[Yy]$ ]] || continue
	fi
	mv "$TEMP" "$out" && break
done
echo "wrote: $out"

archive=$VIDEOS/sources_${name%.mkv}
echo
read -p "archive ${#files[@]} sources to $(basename "$archive")/? [y/N] " a
if [[ $a =~ ^[Yy]$ ]]; then
	mkdir -p "$archive" && for f in "${files[@]}"; do mv "$f" "$archive/"; done
	echo "archived to: $archive"
fi
