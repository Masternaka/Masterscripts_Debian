#!/usr/bin/env bash
# stripgeo: remove GPS/location metadata from images (via exiftool)

all=0 backup=0 recurse=0

usage() {
	cat <<EOF
usage: stripgeo [-a] [-b] [-r] FILE|DIR ...
Remove GPS/location tags from images in place.
  -a, --all        strip ALL metadata, not just GPS
  -b, --backup     keep originals as <file>_original
  -r, --recursive  descend into directories
Without -b the originals are overwritten, so no copy is left holding
the location data. Lists which files carried GPS before stripping.
EOF
}

while [ $# -gt 0 ]; do
	case $1 in
		-a|--all)       all=1 ;;
		-b|--backup)    backup=1 ;;
		-r|--recursive) recurse=1 ;;
		-h|--help)      usage; exit 0 ;;
		--)             shift; break ;;
		-*)             echo "stripgeo: unknown option: $1" >&2; exit 1 ;;
		*)              break ;;
	esac
	shift
done

[ $# -gt 0 ] || { usage >&2; exit 1; }

if ! command -v exiftool >/dev/null; then
	echo "stripgeo: exiftool required (apt install libimage-exiftool-perl / dnf install perl-Image-ExifTool / pacman -S perl-image-exiftool)" >&2
	exit 1
fi

scan=(); [ $recurse = 1 ] && scan+=(-r)
gps=(-if '$GPSLatitude or $GPSLongitude' -p '$filepath')

# files carrying location right now
mapfile -t had < <(exiftool "${scan[@]}" -q -m "${gps[@]}" "$@" 2>/dev/null)

if [ ${#had[@]} -gt 0 ]; then
	echo "location data in ${#had[@]} file(s):"
	printf '  %s\n' "${had[@]}"
elif [ $all = 0 ]; then
	echo "no location data found; nothing to strip"
	exit 0
fi

strip=(-gps:all=); [ $all = 1 ] && strip=(-all=)
[ $backup = 1 ] || strip+=(-overwrite_original)

exiftool "${scan[@]}" -q -m "${strip[@]}" "$@" || {
	echo "stripgeo: exiftool failed" >&2; exit 1; }

# confirm it's gone
mapfile -t left < <(exiftool "${scan[@]}" -q -m "${gps[@]}" "$@" 2>/dev/null)
if [ ${#left[@]} -gt 0 ]; then
	echo "warning: location still present in ${#left[@]} file(s)" >&2
	exit 1
fi

[ $all = 1 ] && echo "stripped all metadata" || echo "location data removed"
[ $backup = 1 ] && echo "originals kept as <file>_original (still contain GPS)"
